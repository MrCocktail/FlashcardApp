<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/flashcard_question"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:text="What's Haiti's capital?"
        android:textColor="@color/white"
        android:textSize="40sp"
        android:gravity="center"
        android:background="@drawable/card_background"
        android:elevation="7dp"
        android:padding="10dp"
        android:layout_margin="20dp"/>

    <TextView
        android:id="@+id/flashcard_answer"
        android:background="@drawable/card_resp_background"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:text="Port-au-Prince"
        android:textSize="40sp"
        android:gravity="center"
        android:visibility="invisible"
        android:layout_margin="20dp"/>

    <!-- Container holding the entire block of choices -->
    <LinearLayout
        android:id="@+id/answers_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:layout_below="@id/flashcard_question"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/rep1"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_margin="10dp"
            android:background="#ffee8c"
            android:gravity="center"
            android:text="Cap-Haïtien"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/rep2"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_margin="10dp"
            android:background="#ffee8c"
            android:gravity="center"
            android:text="Hinche"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/rep3"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_margin="10dp"
            android:background="#ffee8c"
            android:gravity="center"
            android:text="Port-au-Prince"
            android:textSize="20sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/add_card"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/img_desc"
        android:src="@drawable/add_icon" />

    <ImageView
        android:id="@+id/toggle_choices_visibility"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/img_desc"
        android:src="@drawable/hide_icon" />

    <ImageView
        android:id="@+id/next_card_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/img_desc"
        android:src="@drawable/next_icon" />


</RelativeLayout>
