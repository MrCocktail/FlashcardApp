<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- État quand l'EditText a le focus (Sélectionné / Actif) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" /> <!-- Fond blanc -->
            <stroke android:width="2dp" android:color="#FF0000" /> <!-- Bordure ROUGE -->
            <corners android:radius="8dp" /> <!-- Arrondi des angles -->
        </shape>
    </item>

    <!-- État par défaut (Sans focus) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="2dp" android:color="#9E9E9E" /> <!-- Bordure grise bien visible -->
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
